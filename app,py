import streamlit as st
import yfinance as yf
import pandas as pd

st.title("📊 BIST AL/SAT ROBOTU (STABLE)")

stocks = ["THYAO.IS","ASELS.IS","TUPRS.IS","ASTOR.IS"]

def simple_score(df):
    try:
        close = df["Close"]

        ema20 = close.ewm(span=20).mean()
        ema50 = close.ewm(span=50).mean()

        score = 0

        if ema20.iloc[-1] > ema50.iloc[-1]:
            score += 50

        return score
    except:
        return 0


results = []

for s in stocks:
    try:
        df = yf.download(s, period="6mo")

        if df is None or df.empty:
            continue

        sc = simple_score(df)

        if sc > 40:
            signal = "🟢 AL"
        else:
            signal = "🔴 SAT"

        results.append([s, sc, signal])

    except:
        continue


if len(results) == 0:
    st.error("Veri gelmiyor - Streamlit Cloud yfinance blokluyor olabilir")
else:
    st.dataframe(pd.DataFrame(results, columns=["Hisse","Skor","Sinyal"]))
